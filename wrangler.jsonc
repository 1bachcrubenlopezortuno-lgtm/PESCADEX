// Configuración para publicar la web en Cloudflare (Workers con archivos estáticos).
// Cloudflare ejecuta `npm run build` y sirve la carpeta dist/.
{
  "name": "pescadex",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
